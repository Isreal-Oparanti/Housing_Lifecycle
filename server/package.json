{
  "name": "truecost-server",
  "version": "1.0.0",
  "description": "TrueCost Backend API - Council Tax & Rental Intelligence",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "import:rates": "tsx scripts/import-rates.ts"
  },
  "keywords": [
    "truecost",
    "housing",
    "council-tax"
  ],
  "author": "Isreal Oparanti",
  "license": "MIT",
  "dependencies": {
    "@truecost/core": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "fflate": "^0.8.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
