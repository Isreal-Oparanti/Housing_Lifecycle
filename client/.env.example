# Copy to .env.local (git-ignored). Restart `npm run dev` after changing it.

# Street search ("Navarino Road, Hackney"). Free key from https://osdatahub.os.uk:
# create a project, add the OS Names API, copy the key here. Never commit it.
# Without it the app still works from postcodes and outward codes.
# Development-mode projects allow 50 requests a minute; switch the project to live for 600.
OS_API_KEY=

# Optional: address used in link previews. On Vercel the production domain is used automatically.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: override the postcodes.io address.
# POSTCODES_IO_URL=
