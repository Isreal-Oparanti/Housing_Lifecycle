{
  "name": "truecost",
  "private": true,
  "workspaces": [
    "packages/*",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w truecost-server",
    "dev:client": "npm run dev -w truecost-client",
    "test": "npm run test --workspaces --if-present",
